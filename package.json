{
  "name": "mappingout-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "convert": "node scripts/convert.mjs",
    "wiki:compile": "node scripts/wiki/compile.mjs",
    "wiki:apply": "node scripts/wiki/apply.mjs",
    "wiki:fetch:features": "node scripts/wiki/fetch-features.mjs",
    "wiki:compile:features": "node scripts/wiki/compile-features.mjs",
    "wiki:images:armor": "node scripts/wiki/fetch-armor-images.mjs",
    "dev": "vite --host 127.0.0.1",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "npm run validate:data && tsc -b && vite build && node scripts/finalize-build.mjs",
    "build:data": "npm run convert && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check:worker": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && npm run deploy:assets",
    "deploy:assets": "wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "undici": "8.12.4",
    "vite": "^7.2.0",
    "vitest": "^5.1.0",
    "wrangler": "4.160.1"
  }
}
