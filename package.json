{
  "name": "mappingout-web",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "convert": "node scripts/legacy/convert.mjs",
    "wiki:compile": "node scripts/wiki/compile/compile.mjs",
    "wiki:apply": "node scripts/wiki/compile/apply.mjs",
    "wiki:fetch:features": "node scripts/wiki/fetch/fetch-features.mjs",
    "wiki:compile:features": "node scripts/wiki/compile/compile-features.mjs",
    "wiki:images:armor": "node scripts/wiki/fetch/fetch-armor-images.mjs",
    "wiki:icons:materials": "node scripts/wiki/fetch/fetch-material-icons.mjs",
    "wiki:fetch:quests": "node scripts/wiki/fetch/fetch-quests.mjs",
    "wiki:compile:quests": "node scripts/wiki/compile/compile-quests.mjs",
    "wiki:images:quests": "node scripts/wiki/fetch/fetch-quest-images.mjs",
    "wiki:translate:quests": "node scripts/i18n/translate-quests.mjs",
    "wiki:fetch:skills": "node scripts/wiki/fetch/fetch-skill-library.mjs",
    "wiki:compile:skills": "node scripts/wiki/compile/compile-skill-library.mjs",
    "wiki:images:skills": "node scripts/wiki/fetch/fetch-skill-library-images.mjs",
    "wiki:translate:skills": "node scripts/i18n/translate-quests.mjs --skills",
    "dev": "vite --host 127.0.0.1",
    "validate:data": "node scripts/validate/validate-data.mjs",
    "build": "npm run validate:data && npm run validate:i18n && tsc -b && vite build && node scripts/build/finalize-build.mjs",
    "build:data": "npm run convert && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check:worker": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && npm run deploy:assets",
    "deploy:assets": "wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:updates": "vite build --mode desktop && playwright test --config playwright.updates.config.ts",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts",
    "desktop:dev": "node scripts/desktop/desktop.mjs dev",
    "desktop:build": "node scripts/desktop/desktop.mjs build",
    "desktop:build:offline": "node scripts/desktop/desktop.mjs build --config desktop/tauri.offline.conf.json",
    "resources:build": "node scripts/resources/build.mjs",
    "resources:publish": "node scripts/resources/publish.mjs",
    "desktop:build:resources-test": "node scripts/desktop/desktop.mjs build --config desktop/tauri.resources-test.conf.json",
    "test:resources:desktop": "node scripts/resources/smoke.mjs",
    "desktop:frontend:dev": "vite --mode desktop",
    "desktop:frontend:build": "npm run validate:data && npm run validate:i18n && tsc -b && vite build --mode desktop && node scripts/build/desktop-finalize.mjs",
    "desktop:release": "node scripts/desktop/desktop-release.mjs",
    "test:desktop": "node scripts/desktop/desktop-smoke.mjs",
    "desktop:build:release": "node scripts/desktop/desktop-signed.mjs",
    "test:desktop:installed": "node scripts/desktop/desktop-installed-smoke.mjs",
    "validate:i18n": "node scripts/validate/validate-i18n.mjs",
    "i18n:audit": "node scripts/i18n/audit-content.mjs",
    "i18n:compile": "node scripts/i18n/compile-content.mjs",
    "check:release": "node scripts/validate/check-release.mjs",
    "check:release:strict": "node scripts/validate/validate-i18n.mjs --release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "i18next": "^27.1.2",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "undici": "8.12.4",
    "vite": "^7.2.0",
    "vitest": "^5.1.0",
    "wrangler": "4.160.1"
  }
}
