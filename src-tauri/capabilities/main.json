{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main window can use desktop capabilities.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] },
    "updater:default"
  ]
}
