{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MappingOut",
  "version": "1.0.0",
  "identifier": "dev.zhubby.mappingout",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run desktop:frontend:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "MappingOut · 泰瑞亚探索志",
      "width": 1440,
      "height": 920,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "backgroundColor": "#172219"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MappingOut",
    "category": "Utility",
    "shortDescription": "泰瑞亚离线地图与角色探索记录",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "MappingOut"
      }
    }
  }
}
